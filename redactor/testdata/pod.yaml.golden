  name: checkout-7d9f
  namespace: shop
spec:
  containers:
  - args: "<redacted>"
    command: "<redacted>"
    env:
    - name: DB_PASSWORD
      value: "<redacted>"
    - name: MULTILINE
      value: "<redacted>"
    - name: FROM_SECRET
